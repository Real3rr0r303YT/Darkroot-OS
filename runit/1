#!/bin/sh
# Darkroot runit – Stage 1: einmalige Systeminitialisierung
. /etc/runit/functions

printf '\n\033[1;35m  Darkroot Linux\033[0m wird gestartet ...\n\n'

# --- Pseudo-Dateisysteme --------------------------------------------
mountpoint -q /proc || mount -t proc proc /proc -o nosuid,noexec,nodev
mountpoint -q /sys  || mount -t sysfs sys /sys -o nosuid,noexec,nodev
mountpoint -q /run  || mount -t tmpfs run /run -o mode=0755,nosuid,nodev
mountpoint -q /dev  || mount -t devtmpfs dev /dev -o mode=0755,nosuid
mkdir -p /dev/pts /dev/shm /run/lock /run/runit
mountpoint -q /dev/pts || mount -t devpts devpts /dev/pts -o mode=0620,gid=5,nosuid,noexec
mountpoint -q /dev/shm || mount -t tmpfs shm /dev/shm -o mode=1777,nosuid,nodev
mountpoint -q /sys/fs/cgroup || mount -t cgroup2 cgroup2 /sys/fs/cgroup -o nsdelegate,nosuid,noexec,nodev
if [ -d /sys/firmware/efi/efivars ] && ! mountpoint -q /sys/firmware/efi/efivars; then
    mount -t efivarfs efivarfs /sys/firmware/efi/efivars -o nosuid,noexec,nodev
fi
chmod 1777 /run/lock

# Steuerdateien für runit-init (0 = halt, 6 = reboot)
install -m000 /dev/null /run/runit/stopit
install -m000 /dev/null /run/runit/reboot

# --- Kernel-Module ----------------------------------------------------
for f in /etc/modules-load.d/*.conf /usr/lib/modules-load.d/*.conf; do
    [ -r "$f" ] || continue
    grep -Ev '^\s*(#|;|$)' "$f" | while read -r mod; do modprobe -q "$mod"; done
done

# --- udev -------------------------------------------------------------
msg "Geräte werden erkannt (udev)"
if UDEVD=$(find_udevd); then
    "$UDEVD" --daemon
    udevadm trigger --action=add --type=subsystems
    udevadm trigger --action=add --type=devices
    udevadm settle
else
    warn "udevd nicht gefunden!"
fi

# --- Konsole, Hostname, Uhr -------------------------------------------
if [ -r /etc/conf.d/keymaps ]; then
    . /etc/conf.d/keymaps
    [ -n "$keymap" ] && loadkeys -q "$keymap" 2>/dev/null
fi
[ -r /etc/hostname ] && hostname "$(cat /etc/hostname)"
hwclock --hctosys --utc 2>/dev/null

# --- Dateisysteme -----------------------------------------------------
msg "Dateisysteme werden geprüft"
fsck -A -T -a -t noopts=_netdev
rc=$?
if [ $rc -gt 1 ]; then
    emergency_shell "fsck ist fehlgeschlagen (Code $rc)"
fi
mount -o remount,rw /
mount -a -t "nosysfs,nonfs,nonfs4,nosmbfs,nocifs" -O no_netdev
swapon -a

# --- Sonstiges --------------------------------------------------------
ip link set lo up 2>/dev/null
sysctl -q --system 2>/dev/null

if [ -s /var/lib/random-seed ]; then
    cat /var/lib/random-seed > /dev/urandom
fi

if command -v systemd-tmpfiles >/dev/null 2>&1; then
    systemd-tmpfiles --create --remove --boot 2>/dev/null
fi

rm -rf /tmp/.X*-lock /tmp/.X11-unix /tmp/.ICE-unix 2>/dev/null
install -m1777 -d /tmp/.X11-unix /tmp/.ICE-unix
: > /run/utmp; chgrp utmp /run/utmp 2>/dev/null; chmod 664 /run/utmp
dmesg > /var/log/dmesg.log 2>/dev/null

# udevd wird ab Stage 2 von runsv überwacht
[ -n "$UDEVD" ] && udevadm control --exit

ok "Stage 1 abgeschlossen"
exit 0
