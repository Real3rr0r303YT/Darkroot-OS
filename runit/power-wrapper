#!/bin/sh
# Darkroot: reboot / poweroff / halt / shutdown
# Funktioniert unter runit (Standard) und als Fallback unter openrc-init.
name=${0##*/}
act=0
case "$name" in
    reboot) act=6 ;;
    poweroff|halt) act=0 ;;
    shutdown)
        for a in "$@"; do
            case "$a" in -r|--reboot) act=6 ;; esac
        done ;;
esac

if [ "$(id -u)" -ne 0 ]; then
    echo "$name: muss als root ausgeführt werden (sudo $name)" >&2
    exit 1
fi

pid1=$(cat /proc/1/comm 2>/dev/null)
case "$pid1" in
    runit) exec /sbin/runit-init "$act" ;;
    openrc-init)
        if [ "$act" = 6 ]; then exec openrc-shutdown -r now; else exec openrc-shutdown -p now; fi ;;
    *)
        echo "$name: unbekanntes Init-System '$pid1'" >&2
        exit 1 ;;
esac
