#!/bin/sh
# dr-sv – Darkroot Dienstverwaltung für runit
SV=/etc/sv
EN=/etc/runit/runsvdir/default
export SVDIR=/var/service

usage() {
    cat <<EOF
dr-sv – Darkroot runit-Dienste

  dr-sv list                 alle Dienste und ihr Status
  dr-sv enable  DIENST...    Dienst aktivieren (startet sofort)
  dr-sv disable DIENST...    Dienst deaktivieren (stoppt sofort)
  dr-sv start|stop|restart|status DIENST...
EOF
}

need_root() { [ "$(id -u)" -eq 0 ] || { echo "Bitte mit sudo ausführen." >&2; exit 1; }; }

cmd=$1; [ $# -gt 0 ] && shift
case "$cmd" in
    list|ls)
        for d in "$SV"/*/; do
            n=$(basename "$d")
            if [ -L "$EN/$n" ]; then
                st=$(sv status "$n" 2>/dev/null | cut -d: -f1)
                printf '  \033[1;32m●\033[0m %-20s %s\n' "$n" "${st:-?}"
            else
                printf '  \033[2m○ %-20s deaktiviert\033[0m\n' "$n"
            fi
        done ;;
    enable)
        need_root
        for s in "$@"; do
            [ -d "$SV/$s" ] || { echo "Unbekannter Dienst: $s" >&2; continue; }
            ln -sfn "$SV/$s" "$EN/$s" && echo "aktiviert: $s"
        done ;;
    disable)
        need_root
        for s in "$@"; do
            [ -L "$EN/$s" ] || continue
            sv stop "$s" >/dev/null 2>&1
            rm -f "$EN/$s" && echo "deaktiviert: $s"
        done ;;
    start|stop|restart|status|up|down|reload)
        exec sv "$cmd" "$@" ;;
    *) usage ;;
esac
