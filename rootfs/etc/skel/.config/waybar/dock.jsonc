// Darkroot Shell - dock (bottom, centered)
{
    "name": "dock",
    "layer": "top",
    "position": "bottom",
    "exclusive": true,
    "height": 62,
    "margin-bottom": 8,
    "modules-center": [
        "custom/files", "custom/term", "custom/web", "custom/code",
        "custom/spotify", "custom/claude", "custom/theme", "custom/install"
    ],
    "custom/files":   { "format": "", "tooltip": false, "on-click": "thunar" },
    "custom/term":    { "format": "", "tooltip": false, "on-click": "foot" },
    "custom/web":     { "format": "", "tooltip": false, "on-click": "firefox-bin" },
    "custom/code":    { "format": "", "tooltip": false, "on-click": "code" },
    "custom/spotify": { "format": "", "tooltip": false, "on-click": "spotify" },
    "custom/claude":  { "format": "", "tooltip": false, "on-click": "foot -T Claude -e sh -c 'claude || exec bash'" },
    "custom/theme":   { "format": "", "tooltip": false, "on-click": "darkroot-theme toggle" },
    "custom/install": {
        "format": "",
        "tooltip": false,
        "exec": "echo install",
        "exec-if": "test -e /etc/darkroot/live",
        "interval": "once",
        "on-click": "darkroot-install"
    }
}
