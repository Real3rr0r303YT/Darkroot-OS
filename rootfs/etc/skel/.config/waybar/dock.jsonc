// Darkroot Shell - dock (bottom, centered) with real app icons (Papirus)
{
    "name": "dock",
    "layer": "top",
    "position": "bottom",
    "exclusive": true,
    "height": 62,
    "margin-bottom": 8,
    "modules-center": [
        "image#files", "image#term", "image#web", "image#code",
        "image#spotify", "image#claude", "image#theme", "image#install"
    ],
    "image#files":   { "exec": "darkroot-icon system-file-manager org.xfce.thunar Thunar", "interval": 0, "size": 40, "tooltip": false, "on-click": "thunar" },
    "image#term":    { "exec": "darkroot-icon utilities-terminal foot", "interval": 0, "size": 40, "tooltip": false, "on-click": "foot" },
    "image#web":     { "exec": "darkroot-icon firefox firefox-bin", "interval": 0, "size": 40, "tooltip": false, "on-click": "firefox-bin" },
    "image#code":    { "exec": "darkroot-icon visual-studio-code vscode code", "interval": 0, "size": 40, "tooltip": false, "on-click": "code" },
    "image#spotify": { "exec": "darkroot-icon spotify spotify-client", "interval": 0, "size": 40, "tooltip": false, "on-click": "spotify" },
    "image#claude":  { "exec": "darkroot-icon claude-code", "interval": 0, "size": 40, "tooltip": false, "on-click": "foot -T Claude -e sh -c 'claude || exec bash'" },
    "image#theme":   { "exec": "darkroot-icon preferences-desktop-theme preferences-desktop-color", "interval": 0, "size": 40, "tooltip": false, "on-click": "darkroot-theme toggle" },
    "image#install": {
        "exec": "test -e /etc/darkroot/live && darkroot-icon darkroot-install",
        "interval": 0,
        "size": 40,
        "tooltip": false,
        "on-click": "darkroot-install"
    }
}
