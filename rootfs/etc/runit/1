#!/bin/sh
# Darkroot runit - stage 1: one-time system initialisation
. /etc/runit/functions

printf '\n\033[1;35m  Darkroot OS\033[0m is starting ...\n\n'

# --- pseudo filesystems -----------------------------------------------
# Do not trust `mountpoint` here: on the live ISO the root is overlayfs on
# squashfs, where empty lower directories report a different st_dev and look
# like mount points. /proc is checked by content, the rest via /proc/mounts.
[ -r /proc/self/mounts ] || mount -t proc proc /proc -o nosuid,noexec,nodev
is_mounted() { grep -q "^[^ ]* $1 " /proc/self/mounts; }
is_mounted /sys  || mount -t sysfs sys /sys -o nosuid,noexec,nodev
is_mounted /run  || mount -t tmpfs run /run -o mode=0755,nosuid,nodev
is_mounted /dev  || mount -t devtmpfs dev /dev -o mode=0755,nosuid
mkdir -p /dev/pts /dev/shm /run/lock /run/runit
is_mounted /dev/pts || mount -t devpts devpts /dev/pts -o mode=0620,gid=5,nosuid,noexec
is_mounted /dev/shm || mount -t tmpfs shm /dev/shm -o mode=1777,nosuid,nodev
is_mounted /sys/fs/cgroup || mount -t cgroup2 cgroup2 /sys/fs/cgroup -o nsdelegate,nosuid,noexec,nodev
if [ -d /sys/firmware/efi/efivars ] && ! is_mounted /sys/firmware/efi/efivars; then
    mount -t efivarfs efivarfs /sys/firmware/efi/efivars -o nosuid,noexec,nodev
fi
chmod 1777 /run/lock

# control files for runit-init (0 = halt, 6 = reboot)
install -m000 /dev/null /run/runit/stopit
install -m000 /dev/null /run/runit/reboot

# --- kernel modules ---------------------------------------------------
for f in /etc/modules-load.d/*.conf /usr/lib/modules-load.d/*.conf; do
    [ -r "$f" ] || continue
    grep -Ev '^\s*(#|;|$)' "$f" | while read -r mod; do modprobe -q "$mod"; done
done

# --- udev ---------------------------------------------------------------
msg "Detecting hardware (udev)"
if UDEVD=$(find_udevd); then
    "$UDEVD" --daemon
    udevadm trigger --action=add --type=subsystems
    udevadm trigger --action=add --type=devices
    udevadm settle
else
    warn "udevd not found!"
fi

# --- console, hostname, clock -------------------------------------------
if [ -r /etc/conf.d/keymaps ]; then
    . /etc/conf.d/keymaps
    [ -n "$keymap" ] && loadkeys -q "$keymap" 2>/dev/null
fi
[ -r /etc/hostname ] && hostname "$(cat /etc/hostname)"
hwclock --hctosys --utc 2>/dev/null

# --- filesystems ------------------------------------------------------
if is_live; then
    msg "Live session: skipping fsck"
else
    msg "Checking filesystems"
    fsck -A -T -a -t noopts=_netdev
    rc=$?
    if [ $rc -gt 1 ]; then
        emergency_shell "fsck failed (exit code $rc)"
    fi
    mount -o remount,rw /
fi
mount -a -t "nosysfs,nonfs,nonfs4,nosmbfs,nocifs" -O no_netdev
swapon -a 2>/dev/null

# --- misc ---------------------------------------------------------------
ip link set lo up 2>/dev/null
sysctl -q --system 2>/dev/null

if [ -s /var/lib/random-seed ]; then
    cat /var/lib/random-seed > /dev/urandom
fi

if command -v systemd-tmpfiles >/dev/null 2>&1; then
    systemd-tmpfiles --create --remove --boot 2>/dev/null
fi

rm -rf /tmp/.X*-lock /tmp/.X11-unix /tmp/.ICE-unix 2>/dev/null
install -m1777 -d /tmp/.X11-unix /tmp/.ICE-unix
: > /run/utmp; chgrp utmp /run/utmp 2>/dev/null; chmod 664 /run/utmp
dmesg > /var/log/dmesg.log 2>/dev/null

# udevd is supervised by runsv from stage 2 on
[ -n "$UDEVD" ] && udevadm control --exit

ok "Stage 1 done"
exit 0
