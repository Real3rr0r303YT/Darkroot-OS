#!/bin/sh
# dr-sv - Darkroot service manager for runit
SV=/etc/sv
EN=/etc/runit/runsvdir/default
export SVDIR=/var/service

usage() {
    cat <<EOF
dr-sv - manage Darkroot runit services

  dr-sv list                 all services and their state
  dr-sv enable  SERVICE...   enable a service (starts immediately)
  dr-sv disable SERVICE...   disable a service (stops immediately)
  dr-sv start|stop|restart|status SERVICE...
EOF
}

need_root() { [ "$(id -u)" -eq 0 ] || { echo "Please run with sudo." >&2; exit 1; }; }

cmd=$1; [ $# -gt 0 ] && shift
case "$cmd" in
    list|ls)
        for d in "$SV"/*/; do
            n=$(basename "$d")
            if [ -L "$EN/$n" ]; then
                st=$(sv status "$n" 2>/dev/null | cut -d: -f1)
                printf '  \033[1;32m●\033[0m %-20s %s\n' "$n" "${st:-?}"
            else
                printf '  \033[2m○ %-20s disabled\033[0m\n' "$n"
            fi
        done ;;
    enable)
        need_root
        for s in "$@"; do
            [ -d "$SV/$s" ] || { echo "Unknown service: $s" >&2; continue; }
            ln -sfn "$SV/$s" "$EN/$s" && echo "enabled: $s"
        done ;;
    disable)
        need_root
        for s in "$@"; do
            [ -L "$EN/$s" ] || continue
            sv stop "$s" >/dev/null 2>&1
            rm -f "$EN/$s" && echo "disabled: $s"
        done ;;
    start|stop|restart|status|up|down|reload)
        exec sv "$cmd" "$@" ;;
    *) usage ;;
esac
