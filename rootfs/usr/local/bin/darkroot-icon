#!/bin/sh
# darkroot-icon NAME [NAME...] - print the path of the first app icon found.
# Used by the Darkroot Shell dock (Waybar image modules).
for name in "$@"; do
    for f in \
        /usr/share/icons/Papirus-Dark/64x64/apps/$name.svg \
        /usr/share/icons/Papirus/64x64/apps/$name.svg \
        /usr/share/icons/hicolor/scalable/apps/$name.svg \
        /usr/share/icons/hicolor/256x256/apps/$name.png \
        /usr/share/icons/hicolor/128x128/apps/$name.png \
        /usr/share/icons/hicolor/64x64/apps/$name.png \
        /usr/share/icons/hicolor/48x48/apps/$name.png \
        /usr/share/pixmaps/$name.svg \
        /usr/share/pixmaps/$name.png \
        /usr/share/darkroot/icons/$name.svg; do
        [ -r "$f" ] && { echo "$f"; exit 0; }
    done
done
echo /usr/share/darkroot/icons/darkroot.svg
